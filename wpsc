#!/usr/bin/env bash
set -Eeuo pipefail

SERVICE_NAME="webpanel"
INSTALL_DIR="/opt/webpanel"

usage() {
    cat <<'EOF'
WebPanel terminal control

Usage:
  wpsc                  Open the interactive menu
  wpsc status           Show service status
  wpsc start            Start WebPanel
  wpsc stop             Stop WebPanel
  wpsc restart          Restart WebPanel
  wpsc reload           Restart WebPanel (the app has no reload signal)
  wpsc repair           Check and repair common panel installation issues
  wpsc logs [lines]     Show recent service logs (default: 50)
  wpsc follow           Follow live service logs
  wpsc help             Show this help
EOF
}

run_systemctl() {
    if [[ "$(id -u)" -eq 0 ]]; then
        systemctl "$@"
    elif command -v sudo >/dev/null 2>&1; then
        sudo systemctl "$@"
    else
        printf '%s\n' "This command needs root privileges. Run it as root or install sudo." >&2
        return 1
    fi
}

run_journalctl() {
    if [[ "$(id -u)" -eq 0 ]]; then
        journalctl "$@"
    elif command -v sudo >/dev/null 2>&1; then
        sudo journalctl "$@"
    else
        printf '%s\n' "Reading service logs needs root privileges. Run as root or install sudo." >&2
        return 1
    fi
}

run_privileged() {
    if [[ "$(id -u)" -eq 0 ]]; then
        "$@"
    elif command -v sudo >/dev/null 2>&1; then
        sudo "$@"
    else
        printf '%s\n' "This repair needs root privileges. Run it as root or install sudo." >&2
        return 1
    fi
}

show_status() {
    run_systemctl --no-pager --full status "$SERVICE_NAME"
}

show_logs() {
    local lines="${1:-50}"
    if [[ ! "$lines" =~ ^[1-9][0-9]{0,3}$ ]]; then
        printf '%s\n' "Log line count must be between 1 and 9999." >&2
        return 2
    fi
    run_journalctl --no-pager -u "$SERVICE_NAME" -n "$lines"
}

repair_panel() {
    local failed=0
    local database_path="${INSTALL_DIR}/webpanel.db"
    local attempt
    local healthy=0

    printf '%s\n' '[1/6] Checking installation files'
    for path in \
        "${INSTALL_DIR}/main.py" \
        "${INSTALL_DIR}/requirements.txt" \
        "${INSTALL_DIR}/database.py"; do
        if [[ -f "$path" ]]; then
            printf '  [OK] %s\n' "$path"
        else
            printf '  [ERROR] Missing %s\n' "$path" >&2
            failed=1
        fi
    done
    [[ "$failed" -eq 0 ]] || return 1

    printf '%s\n' '[2/6] Checking Python environment and dependencies'
    if [[ ! -x "${INSTALL_DIR}/venv/bin/python" ]]; then
        printf '%s\n' '  [REPAIR] Creating the missing Python virtual environment.'
        if ! run_privileged python3 -m venv "${INSTALL_DIR}/venv"; then
            printf '%s\n' '  [ERROR] Could not create the virtual environment.' >&2
            return 1
        fi
    fi
    if ! run_privileged "${INSTALL_DIR}/venv/bin/python" -m pip check; then
        printf '%s\n' '  [REPAIR] Installing dependencies from requirements.txt.'
        if ! run_privileged "${INSTALL_DIR}/venv/bin/python" -m pip install -r "${INSTALL_DIR}/requirements.txt"; then
            printf '%s\n' '  [ERROR] Dependency installation failed.' >&2
            return 1
        fi
        if ! run_privileged "${INSTALL_DIR}/venv/bin/python" -m pip check; then
            printf '%s\n' '  [ERROR] Dependencies are still inconsistent after repair.' >&2
            return 1
        fi
    fi
    printf '%s\n' '  [OK] Python dependencies are consistent.'

    printf '%s\n' '[3/6] Checking Python source syntax'
    if ! run_privileged "${INSTALL_DIR}/venv/bin/python" -m compileall -q \
        "${INSTALL_DIR}/main.py" "${INSTALL_DIR}/routers" "${INSTALL_DIR}/services"; then
        printf '%s\n' '  [ERROR] Python syntax errors found; source files were not changed.' >&2
        failed=1
    else
        printf '%s\n' '  [OK] Python files compile.'
    fi

    printf '%s\n' '[4/6] Checking database integrity'
    if [[ -f "$database_path" ]]; then
        if run_privileged "${INSTALL_DIR}/venv/bin/python" -c \
            'import sqlite3,sys; c=sqlite3.connect("file:"+sys.argv[1]+"?mode=ro", uri=True); r=c.execute("PRAGMA integrity_check").fetchone()[0]; c.close(); print(r); sys.exit(0 if r == "ok" else 1)' \
            "$database_path"; then
            printf '%s\n' '  [OK] SQLite database is readable and consistent.'
        else
            printf '%s\n' '  [ERROR] Database integrity check failed; no automatic database changes were made.' >&2
            failed=1
        fi
    else
        printf '  [ERROR] Database not found: %s\n' "$database_path" >&2
        failed=1
    fi

    printf '%s\n' '[5/6] Reloading systemd and restarting WebPanel'
    if ! run_systemctl daemon-reload || ! run_systemctl restart "$SERVICE_NAME"; then
        printf '%s\n' '  [ERROR] Could not reload or restart the WebPanel service.' >&2
        run_journalctl --no-pager -u "$SERVICE_NAME" -n 40 || true
        return 1
    fi

    printf '%s\n' '[6/6] Verifying service and login page'
    for attempt in {1..10}; do
        if run_systemctl is-active --quiet "$SERVICE_NAME" \
            && command -v curl >/dev/null 2>&1 \
            && curl --fail --silent --max-time 3 \
                http://127.0.0.1:8080/login >/dev/null; then
            healthy=1
            break
        fi
        sleep 1
    done
    if [[ "$healthy" -eq 1 ]]; then
        printf '%s\n' '  [OK] WebPanel is active and the login page responds.'
    else
        printf '%s\n' '  [ERROR] The service or login-page check failed.' >&2
        run_journalctl --no-pager -u "$SERVICE_NAME" -n 40 || true
        failed=1
    fi

    if [[ "$failed" -eq 0 ]]; then
        printf '%s\n' 'Repair checks completed successfully.'
    else
        printf '%s\n' 'Repair completed with unresolved errors; review the messages above and service logs.' >&2
    fi
    return "$failed"
}

interactive_menu() {
    local choice
    while true; do
        printf '\nWebPanel CLI (wpsc)\n'
        printf '%s\n' \
            '  1) Service status' \
            '  2) Start panel' \
            '  3) Stop panel' \
            '  4) Restart panel' \
            '  5) Recent logs' \
            '  6) Follow live logs' \
            '  7) Repair panel' \
            '  0) Exit'
        read -r -p "Select an option: " choice || return 0
        case "$choice" in
            1) show_status || true ;;
            2) run_systemctl start "$SERVICE_NAME" ;;
            3)
                read -r -p "Stop WebPanel? [y/N] " choice || return 0
                if [[ "$choice" == "y" || "$choice" == "Y" ]]; then
                    run_systemctl stop "$SERVICE_NAME"
                fi
                ;;
            4) run_systemctl restart "$SERVICE_NAME" ;;
            5) show_logs ;;
            6) run_journalctl -fu "$SERVICE_NAME" ;;
            7) repair_panel ;;
            0) return 0 ;;
            *) printf '%s\n' "Unknown option." >&2 ;;
        esac
    done
}

command="${1:-menu}"
case "$command" in
    menu) interactive_menu ;;
    status) show_status ;;
    start|stop|restart) run_systemctl "$command" "$SERVICE_NAME" ;;
    reload)
        printf '%s\n' "WebPanel does not support a reload signal; restarting the service."
        run_systemctl restart "$SERVICE_NAME"
        ;;
    repair) repair_panel ;;
    logs) show_logs "${2:-50}" ;;
    follow) run_journalctl -fu "$SERVICE_NAME" ;;
    help|-h|--help) usage ;;
    *)
        printf 'Unknown command: %s\n\n' "$command" >&2
        usage >&2
        exit 2
        ;;
esac
